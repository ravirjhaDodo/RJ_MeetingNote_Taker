# Copy to .env.local at project root (gitignored).
# Vercel: add the same variables in Project Settings → Environment Variables.
# FIREBASE_SERVICE_ACCOUNT_JSON must be a single-line JSON string.

OPENAI_API_KEY=your-openai-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
API_KEY_ENCRYPTION_SECRET=use-a-long-random-secret-at-least-24-chars
ADMIN_EMAIL=your-admin-email@example.com

QDRANT_URL=https://your-cluster-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=rj_meeting_notes
QDRANT_VECTOR_SIZE=1536

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_NOTES_MODEL=gpt-4.1-mini

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=RJ Meeting Notes Taker <onboarding@resend.dev>

# Firebase Admin SDK (Vercel api/rj.js + seed/set-password scripts)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Optional: owner seed password (scripts/seed-platform-owner.js)
# OWNER_SEED_PASSWORD=change-me

# functions/.env.local — copy all EXCEPT FIREBASE_SERVICE_ACCOUNT_JSON for emulator
